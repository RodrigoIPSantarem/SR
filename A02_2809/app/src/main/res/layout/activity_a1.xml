<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".A1">


    <!-- better notation for an empty element -->
    <!-- ULC -->
    <Button
        android:id="@+id/id_btn_ulc"
        android:onClick="respondToTheClick"
        android:text="@string/str_btn_ulc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        />

    <!-- URC -->
    <Button
        android:id="@+id/id_btn_urc"
        android:text="@string/str_btn_urc"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        />

    <!-- LLC -->
    <Button
        android:id="@+id/id_btn_llc"
        android:text="@string/str_btn_llc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        />

    <!-- LRC -->
    <Button
        android:id="@+id/id_btn_lrc"
        android:text="@string/str_btn_lrc"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        />



</androidx.constraintlayout.widget.ConstraintLayout>
